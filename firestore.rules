rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to verify user owns the document via userId field
    function isOwner() {
      return request.auth != null && (
        // When creating a new document, check the incoming data
        (request.method == 'create' && request.resource.data.userId == request.auth.uid) ||
        // When reading/updating/deleting, check the existing document data
        (request.method != 'create' && resource != null && resource.data.userId == request.auth.uid)
      );
    }

    // Profiles use the UID as the document ID, so we check the ID instead of a field
    match /profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // All other collections use the userId field to determine ownership
    match /habits/{document=**} { allow read, write: if isOwner(); }
    match /tasks/{document=**} { allow read, write: if isOwner(); }
    match /skincare/{document=**} { allow read, write: if isOwner(); }
    match /media_archive/{document=**} { allow read, write: if isOwner(); }
    match /cycles/{document=**} { allow read, write: if isOwner(); }
    match /calendar/{document=**} { allow read, write: if isOwner(); }
    match /exam_topics/{document=**} { allow read, write: if isOwner(); }
    match /exams/{document=**} { allow read, write: if isOwner(); }
  }
}
